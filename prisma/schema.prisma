/**
 * Prisma ORM 数据库模型定义文件
 * 文件功能说明：
 * - 定义去中心化社交平台的所有数据库表结构
 * - 配置数据库连接和Prisma客户端生成选项
 * - 建立表之间的关系（一对一、一对多、多对多）
 * - 定义索引、唯一约束和数据完整性规则
 * 数据库技术栈：
 * - 数据库：MySQL 8.0+（关系型数据库）
 * - ORM：Prisma 6.x（类型安全的ORM）
 * - 客户端生成：prisma-client-js
 * 核心设计原则：
 * 1. 数据完整性：使用外键约束确保引用完整性
 * 2. 性能优化：为常用查询字段添加索引
 * 3. 安全性：敏感数据加密存储（密码、MFA密钥等）
 * 4. 可扩展性：支持软删除、时间戳审计等特性
 * 模型分类：
 * ┌─────────────────────────────────────────────────────┐
 * │ 用户相关 (User System)                              │
 * │   - user: 用户基本信息                              │
 * │   - adminauditlog: 管理员操作日志                    │
 * │   - adminsession: 管理员会话                        │
 * ├─────────────────────────────────────────────────────┤
 * │ 内容管理 (Content Management)                       │
 * │   - article: 文章/帖子                              │
 * │   - moment: 动态/短内容                             │
 * │   - topic: 话题标签                                 │
 * │   - circle: 圈子/社群                               │
 * ├─────────────────────────────────────────────────────┤
 * │ 社交互动 (Social Interactions)                      │
 * │   - articlelike/momentlike: 点赞                    │
 * │   - articlecomment/momentcomment: 评论              │
 * │   - articlerepost/momentrepost: 转发               │
 * │   - articlecollection/momentcollection: 收藏        │
 * ├─────────────────────────────────────────────────────┤
 * │ 消息通信 (Messaging)                                │
 * │   - message: 私信消息                               │
 * │   - notification: 系统通知                          │
 * ├─────────────────────────────────────────────────────┤
 * │ 安全与审核 (Security & Moderation)                  │
 * │   - report: 举报记录                                │
 * └─────────────────────────────────────────────────────┘
 * 关系类型说明：
 * - @relation: 定义外键关系
 * - onDelete: Cascade (级联删除) | Restrict (限制删除)
 * - @@unique: 复合唯一约束（防止重复数据）
 * - @@index: 数据库索引（加速查询）
 * @module schema.prisma
 * @version 2.0.0
 * @author 项目开发团队
 * @see https://www.prisma.io/docs/concepts/components/prisma-schema
 */

/**
 * Prisma Client 生成器配置
 * @description 配置Prisma Client的生成方式
 * - provider: 使用JavaScript/TypeScript运行时
 */
generator client {
  provider = "prisma-client-js"
}

/**
 * 数据源配置
 * @description 定义数据库连接信息
 * - provider: MySQL数据库引擎
 * - url: 从环境变量DATABASE_URL读取连接字符串
 * @env DATABASE_URL 格式：mysql://user:password@host:port/database
 * @example mysql://root:password@localhost:3306/social_platform
 */
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model article {
  id                Int                 @id @default(autoincrement())
  title             String              @db.VarChar(200)
  content           String              @db.LongText
  coverCid          String?             @db.VarChar(255)
  tags              String?             @db.Text
  authorId          Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  circleId          Int?
  mediaCid          String?             @db.VarChar(255)
  visibility        String              @default("public") @db.VarChar(20)
  user              user                @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "Article_authorId_fkey")
  circle            circle?             @relation(fields: [circleId], references: [id], map: "Article_circleId_fkey")
  articlecollection articlecollection[]
  articlecomment    articlecomment[]
  articlelike       articlelike[]
  articletopic      articletopic[]
  articlerepost     articlerepost[]

  @@index([authorId], map: "Article_authorId_fkey")
  @@index([circleId], map: "Article_circleId_fkey")
}

model articlecomment {
  id                   Int              @id @default(autoincrement())
  articleId            Int
  content              String           @db.Text
  createdAt            DateTime         @default(now())
  authorId             Int
  replyToId            Int?
  article              article          @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "ArticleComment_articleId_fkey")
  user                 user             @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "ArticleComment_authorId_fkey")
  articlecomment       articlecomment?  @relation("articlecommentToarticlecomment", fields: [replyToId], references: [id], map: "ArticleComment_replyToId_fkey")
  other_articlecomment articlecomment[] @relation("articlecommentToarticlecomment")

  @@index([articleId], map: "ArticleComment_articleId_fkey")
  @@index([authorId], map: "ArticleComment_authorId_fkey")
  @@index([replyToId], map: "ArticleComment_replyToId_fkey")
}

model articlelike {
  id        Int      @id @default(autoincrement())
  articleId Int
  userId    Int
  createdAt DateTime @default(now())
  article   article  @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "ArticleLike_articleId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ArticleLike_userId_fkey")

  @@unique([articleId, userId], map: "ArticleLike_articleId_userId_key")
  @@index([userId], map: "ArticleLike_userId_fkey")
}

model articlecollection {
  id        Int      @id @default(autoincrement())
  articleId Int
  userId    Int
  createdAt DateTime @default(now())
  article   article  @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "ArticleCollection_articleId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ArticleCollection_userId_fkey")

  @@unique([articleId, userId], map: "ArticleCollection_articleId_userId_key")
  @@index([userId], map: "ArticleCollection_userId_fkey")
}

model articletopic {
  id        Int      @id @default(autoincrement())
  articleId Int
  topicId   Int
  createdAt DateTime @default(now())
  article   article  @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "ArticleTopic_articleId_fkey")
  topic     topic    @relation(fields: [topicId], references: [id], onDelete: Cascade, map: "ArticleTopic_topicId_fkey")

  @@unique([articleId, topicId], map: "ArticleTopic_articleId_topicId_key")
  @@index([articleId], map: "ArticleTopic_articleId_fkey")
  @@index([topicId], map: "ArticleTopic_topicId_fkey")
}

model moment {
  id               Int                @id @default(autoincrement())
  content          String             @db.Text
  mediaCid         String?            @db.VarChar(255)
  visibility       String             @default("public") @db.VarChar(20)
  authorId         Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  user             user               @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "Moment_authorId_fkey")
  momentcollection momentcollection[]
  momentcomment    momentcomment[]
  momentlike       momentlike[]
  momenttopic      momenttopic[]
  momentrepost     momentrepost[]

  @@index([authorId], map: "Moment_authorId_fkey")
}

model momentcomment {
  id                  Int             @id @default(autoincrement())
  momentId            Int
  content             String          @db.Text
  createdAt           DateTime        @default(now())
  authorId            Int
  replyToId           Int?
  user                user            @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "MomentComment_authorId_fkey")
  moment              moment          @relation(fields: [momentId], references: [id], onDelete: Cascade, map: "MomentComment_momentId_fkey")
  momentcomment       momentcomment?  @relation("momentcommentTomomentcomment", fields: [replyToId], references: [id], map: "MomentComment_replyToId_fkey")
  other_momentcomment momentcomment[] @relation("momentcommentTomomentcomment")

  @@index([momentId], map: "MomentComment_momentId_fkey")
  @@index([authorId], map: "MomentComment_authorId_fkey")
  @@index([replyToId], map: "MomentComment_replyToId_fkey")
}

model momentlike {
  id        Int      @id @default(autoincrement())
  momentId  Int
  userId    Int
  createdAt DateTime @default(now())
  moment    moment   @relation(fields: [momentId], references: [id], onDelete: Cascade, map: "MomentLike_momentId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "MomentLike_userId_fkey")

  @@unique([momentId, userId], map: "MomentLike_momentId_userId_key")
  @@index([userId], map: "MomentLike_userId_fkey")
}

model momentcollection {
  id        Int      @id @default(autoincrement())
  momentId  Int
  userId    Int
  createdAt DateTime @default(now())
  moment    moment   @relation(fields: [momentId], references: [id], onDelete: Cascade, map: "MomentCollection_momentId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "MomentCollection_userId_fkey")

  @@unique([momentId, userId], map: "MomentCollection_momentId_userId_key")
  @@index([userId], map: "MomentCollection_userId_fkey")
}

model momenttopic {
  id        Int      @id @default(autoincrement())
  momentId  Int
  topicId   Int
  createdAt DateTime @default(now())
  moment    moment   @relation(fields: [momentId], references: [id], onDelete: Cascade, map: "MomentTopic_momentId_fkey")
  topic     topic    @relation(fields: [topicId], references: [id], onDelete: Cascade, map: "MomentTopic_topicId_fkey")

  @@unique([momentId, topicId], map: "MomentTopic_momentId_topicId_key")
  @@index([momentId], map: "MomentTopic_momentId_fkey")
  @@index([topicId], map: "MomentTopic_topicId_fkey")
}

model momentrepost {
  id        Int      @id @default(autoincrement())
  momentId  Int
  userId    Int
  createdAt DateTime @default(now())
  moment    moment   @relation(fields: [momentId], references: [id], onDelete: Cascade, map: "MomentRepost_momentId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "MomentRepost_userId_fkey")

  @@unique([momentId, userId], name: "MomentRepost_momentId_userId_key")
  @@index([momentId], map: "MomentRepost_momentId_fkey")
  @@index([userId], map: "MomentRepost_userId_fkey")
}

model articlerepost {
  id        Int      @id @default(autoincrement())
  articleId Int
  userId    Int
  createdAt DateTime @default(now())
  article   article  @relation(fields: [articleId], references: [id], onDelete: Cascade, map: "ArticleRepost_articleId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ArticleRepost_userId_fkey")

  @@unique([articleId, userId], name: "ArticleRepost_articleId_userId_key")
  @@index([articleId], map: "ArticleRepost_articleId_fkey")
  @@index([userId], map: "ArticleRepost_userId_fkey")
}

model circle {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(100)
  description   String?         @db.Text
  avatarCid     String?         @db.VarChar(255)
  category      String          @db.VarChar(50)
  creatorId     Int
  adminIds      String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  article       article[]
  user          user            @relation(fields: [creatorId], references: [id], onDelete: Cascade, map: "Circle_creatorId_fkey")
  circlemembers circlemembers[]

  @@index([creatorId], map: "Circle_creatorId_fkey")
}

model circlemembers {
  id        Int      @id @default(autoincrement())
  circleId  Int
  userId    Int
  createdAt DateTime @default(now())
  circle    circle   @relation(fields: [circleId], references: [id], onDelete: Cascade, map: "CircleMembers_circleId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "CircleMembers_userId_fkey")

  @@unique([circleId, userId], map: "CircleMembers_circleId_userId_key")
  @@index([userId], map: "CircleMembers_userId_fkey")
}

model message {
  id                            Int      @id @default(autoincrement())
  content                       String   @db.Text
  mediaCid                      String?  @db.VarChar(255)
  isRead                        Boolean  @default(false)
  senderId                      Int
  receiverId                    Int
  createdAt                     DateTime @default(now())
  user_message_receiverIdTouser user     @relation("message_receiverIdTouser", fields: [receiverId], references: [id], onDelete: Cascade, map: "Message_receiverId_fkey")
  user_message_senderIdTouser   user     @relation("message_senderIdTouser", fields: [senderId], references: [id], onDelete: Cascade, map: "Message_senderId_fkey")

  @@index([receiverId], map: "Message_receiverId_fkey")
  @@index([senderId], map: "Message_senderId_fkey")
  @@index([senderId, receiverId, createdAt], map: "Message_senderId_receiverId_createdAt_idx")
}

model notification {
  id         Int      @id @default(autoincrement())
  type       String   @db.VarChar(20)
  userId     Int
  fromUserId Int?
  commentId  Int?
  content    String?  @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  articleId  Int?
  momentId   Int?

  @@index([userId, createdAt], map: "Notification_userId_createdAt_idx")
  @@index([userId, isRead], map: "Notification_userId_isRead_idx")
}

model topic {
  id           Int            @id @default(autoincrement())
  name         String         @unique @db.VarChar(100)
  description  String?        @db.Text
  postCount    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  articletopic articletopic[]
  momenttopic  momenttopic[]

  @@index([name], map: "Topic_name_idx")
  @@index([postCount], map: "Topic_postCount_idx")
}

model report {
  id          Int      @id @default(autoincrement())
  reason      String   @db.VarChar(100)
  reporterId  Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  description String?  @db.Text
  targetId    Int
  type        String   @db.VarChar(20)
  user        user     @relation(fields: [reporterId], references: [id], onDelete: Cascade, map: "Report_reporterId_fkey")

  @@index([reporterId], map: "Report_reporterId_fkey")
}

model user {
  id                                        Int                 @id @default(autoincrement())
  username                                  String              @unique(map: "User_username_key") @db.VarChar(50)
  password                                  String              @db.VarChar(100)
  avatarCid                                 String?             @db.VarChar(255)
  bio                                       String?             @db.Text
  isAdmin                                   Boolean             @default(false)
  isFrozen                                  Boolean             @default(false)
  blockedUserIds                            String?             @db.Text
  createdAt                                 DateTime            @default(now())
  updatedAt                                 DateTime
  allowFollow                               Boolean             @default(true)
  allowMessage                              Boolean             @default(true)
  hideFollowers                             Boolean             @default(false)
  hideFollowing                             Boolean             @default(false)
  hideLikes                                 Boolean             @default(false)
  hideCollections                           Boolean             @default(false)
  backgroundCid                             String?             @db.VarChar(255)
  backgroundColor                           String              @default("#f0f0f0") @db.VarChar(7)
  globalBackgroundCid                       String?             @db.VarChar(255)
  globalBackgroundColor                     String              @default("#ffffff") @db.VarChar(7)
  nickname                                  String?             @db.VarChar(50)
  adminDeviceBound                          Boolean             @default(false)
  adminDeviceFingerprint                    String?             @db.VarChar(255)
  adminSessionToken                         String?             @db.VarChar(255)
  failedLoginAttempts                       Int                 @default(0)
  githubId                                  String?             @unique @db.VarChar(50)
  avatarUrl                                 String?             @db.VarChar(500)
  lastAdminLogin                            DateTime?
  lockedUntil                               DateTime?
  mfaEnabled                                Boolean             @default(false)
  mfaSecret                                 String?             @db.VarChar(255)
  colorScheme                               String              @default("light") @db.VarChar(10)
  defaultVisibility                         String              @default("public") @db.VarChar(20)
  fontSize                                  String              @default("medium") @db.VarChar(10)
  language                                  String              @default("zh-CN") @db.VarChar(10)
  email                                     String?             @unique @db.VarChar(255)
  emailVerified                             Boolean             @default(false)
  emailVerifyToken                          String?             @db.VarChar(255)
  emailVerifyTokenExpires                   DateTime?
  avatarDescription                         String?             @db.Text
  website                                   String?             @db.VarChar(255)
  location                                  String?             @db.VarChar(100)
  notificationPreferences                   String?             @db.Text
  adminauditlog                             adminauditlog[]
  adminsession                              adminsession[]
  article                                   article[]
  articlecollection                         articlecollection[]
  articlecomment                            articlecomment[]
  articlelike                               articlelike[]
  articlerepost                             articlerepost[]
  circle                                    circle[]
  circlemembers                             circlemembers[]
  message_message_receiverIdTouser          message[]           @relation("message_receiverIdTouser")
  message_message_senderIdTouser            message[]           @relation("message_senderIdTouser")
  moment                                    moment[]
  momentcollection                          momentcollection[]
  momentcomment                             momentcomment[]
  momentlike                                momentlike[]
  momentrepost                              momentrepost[]
  report                                    report[]
  userfollows_userfollows_followerIdTouser  userfollows[]       @relation("userfollows_followerIdTouser")
  userfollows_userfollows_followingIdTouser userfollows[]       @relation("userfollows_followingIdTouser")
  AiConversation                            AiConversation[]
  AiUserProfile                             AiUserProfile?
  UserDevice                                UserDevice[]
  LoginHistory                              LoginHistory[]

  @@index([adminDeviceFingerprint], map: "User_adminDeviceFingerprint_idx")
  @@index([githubId], map: "User_githubId_idx")
}

model userfollows {
  id                                 Int      @id @default(autoincrement())
  followerId                         Int
  followingId                        Int
  createdAt                          DateTime @default(now())
  user_userfollows_followerIdTouser  user     @relation("userfollows_followerIdTouser", fields: [followerId], references: [id], onDelete: Cascade, map: "UserFollows_followerId_fkey")
  user_userfollows_followingIdTouser user     @relation("userfollows_followingIdTouser", fields: [followingId], references: [id], onDelete: Cascade, map: "UserFollows_followingId_fkey")

  @@unique([followerId, followingId], map: "UserFollows_followerId_followingId_key")
  @@index([followingId], map: "UserFollows_followingId_fkey")
}

model adminsession {
  id                Int      @id @default(autoincrement())
  userId            Int
  sessionToken      String   @unique @db.VarChar(255)
  deviceFingerprint String   @db.VarChar(255)
  ipAddress         String?  @db.VarChar(45)
  userAgent         String?  @db.Text
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  user              user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AdminSession_userId_fkey")

  @@index([userId], map: "AdminSession_userId_fkey")
}

model adminauditlog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String   @db.VarChar(100)
  targetType String?  @db.VarChar(50)
  targetId   Int?
  details    String?  @db.Text
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "AdminAuditLog_userId_fkey")

  @@index([userId], map: "AdminAuditLog_userId_fkey")
  @@index([action], map: "AdminAuditLog_action_idx")
  @@index([createdAt], map: "AdminAuditLog_createdAt_idx")
}

model AiConversation {
  id        Int         @id @default(autoincrement())
  userId    Int
  title     String      @db.VarChar(100)
  model     String      @default("deepseek-v4-pro") @db.VarChar(50)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]
  user      user        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model AiMessage {
  id             Int            @id @default(autoincrement())
  conversationId Int
  role           String         @db.VarChar(20)
  content        String         @db.Text
  imageUrl       String?        @db.VarChar(500)
  tokenInput     Int?
  tokenOutput    Int?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiDocument {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  content   String   @db.LongText
  source    String   @db.VarChar(100)
  embedding String?  @db.LongText
  createdAt DateTime @default(now())

  @@index([source])
}

model AiUserProfile {
  userId    Int     @id
  language  String? @db.VarChar(10)
  interests String? @db.Text
  expertise String? @db.VarChar(50)
  user      user    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDevice {
  id           Int            @id @default(autoincrement())
  userId       Int
  deviceHash   String         @db.VarChar(64)
  deviceUUID   String?        @db.VarChar(36)
  deviceName   String         @db.VarChar(200)
  deviceType   String?        @db.VarChar(20)
  os           String?        @db.VarChar(50)
  browser      String?        @db.VarChar(50)
  ipAddress    String?        @db.VarChar(45)
  location     String?        @db.VarChar(100)
  isActive     Boolean        @default(true)
  firstSeenAt  DateTime       @default(now())
  lastSeenAt   DateTime       @updatedAt
  user         user           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserDevice_userId_fkey")
  LoginHistory LoginHistory[]

  @@unique([userId, deviceHash], map: "UserDevice_userId_deviceHash_key")
  @@index([userId], map: "UserDevice_userId_idx")
  @@index([deviceUUID], map: "UserDevice_deviceUUID_idx")
}

model LoginHistory {
  id        Int         @id @default(autoincrement())
  userId    Int
  deviceId  Int?
  ipAddress String?     @db.VarChar(45)
  location  String?     @db.VarChar(100)
  userAgent String?     @db.Text
  success   Boolean     @default(true)
  createdAt DateTime    @default(now())
  user      user        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "LoginHistory_userId_fkey")
  device    UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull, map: "LoginHistory_deviceId_fkey")

  @@index([userId, createdAt], map: "LoginHistory_userId_createdAt_idx")
}
