# ============================================================
#  去中心化社交平台 — 后端环境变量配置模板
# ============================================================
#  使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 根据下方说明填写实际的配置值
#   3. 切勿将 .env 文件提交到 Git 仓库
# ============================================================

# ── 数据库配置 ──
# MySQL 连接字符串，格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://root:your_password@localhost:3306/bishe?schema=public&charset=utf8mb4&collation=utf8mb4_unicode_ci"

# Redis 连接字符串
REDIS_URL="redis://127.0.0.1:6379"

# ── JWT 认证配置 ──
# JWT 签名密钥 — 使用 64 位随机 hex 字符串
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="在此填写64位随机hex字符串"
# 数据加密密钥 — 同样使用 64 位随机 hex 字符串
ENCRYPTION_KEY="在此填写64位随机hex字符串"
# JWT Token 过期时间
JWT_EXPIRATION="7d"

# ── 服务器配置 ──
# 后端监听端口（默认 3001）
NEST_PORT=3001
# 运行环境：development | production
NODE_ENV="development"
# CORS 允许的源地址（多个用逗号分隔）
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ── Pinata IPFS 配置 ──
# 获取方式：https://app.pinata.cloud/developers/api-keys
# 推荐使用 JWT 认证方式（二选一即可）
PINATA_JWT=在此填写Pinata_JWT_Token
# 或者使用 API Key + API Secret（JWT 优先）
PINATA_API_KEY=在此填写Pinata_API_Key
PINATA_API_SECRET=在此填写Pinata_API_Secret
# Pinata 专用网关（可选，默认使用公共网关）
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── GitHub OAuth 配置 ──
# 获取方式：https://github.com/settings/developers → New OAuth App
# 开发环境: Homepage URL=http://localhost:3000 / Callback=http://localhost:3001/api/auth/github/callback
# 生产环境: Homepage URL=https://app.desocial.com / Callback=https://app.desocial.com/api/auth/github/callback
GITHUB_CLIENT_ID=在此填写GitHub_OAuth_Client_ID
GITHUB_CLIENT_SECRET=在此填写GitHub_OAuth_Client_Secret
GITHUB_CALLBACK_URL=https://app.desocial.com/api/auth/github/callback
# 前端地址（用于OAuth回调重定向，生产环境使用 Pages 域名）
FRONTEND_URL=https://app.desocial.com

# ── DeepSeek AI 配置 ──
# 获取方式：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=在此填写DeepSeek_API_Key
# DeepSeek API 地址（通常不需要修改）
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
